{
	"manifest_version": 3,
	"name": "MA Field Guide: Knowledge Graph Export",
	"version": "1.0.0",
	"description": "Saves your Math Academy activity as a small file for the MA Field Guide knowledge graph. Nothing leaves your browser.",
	"action": {
		"default_title": "Export my Math Academy activity",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/16.png",
			"48": "icons/48.png",
			"128": "icons/128.png"
		}
	},
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"permissions": ["scripting", "storage", "activeTab"],
	"background": {
		"scripts": ["background.js"]
	},
	"host_permissions": ["https://mathacademy.com/*", "https://www.mathacademy.com/*"],
	"browser_specific_settings": {
		"gecko": {
			"id": "exporter@mafieldguide.com",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		},
		"gecko_android": {
			"strict_min_version": "142.0"
		}
	}
}
